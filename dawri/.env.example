# ---------- Frontend (Part 2: web/config.js) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
VAPID_PUBLIC_KEY=generated-by-scripts/gen-vapid.ts

# ---------- Edge Function secrets (supabase secrets set ...) ----------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
SITE_URL=https://your-site.netlify.app
VAPID_PRIVATE_KEY=generated-by-scripts/gen-vapid.ts
VAPID_SUBJECT=mailto:you@example.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_VISION=claude-sonnet-5-5
AI_DAILY_CAP=200
# Optional: a separate secret the cron jobs may use instead of the service role key
CRON_SECRET=
